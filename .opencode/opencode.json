{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": "*PRD.md", "effect": "deny" }
  ],
  "experimental": {
    "policies": [
      { "action": "permission", "resource": "edit:*PRD.md", "effect": "deny" }
    ]
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    }
  }
}
