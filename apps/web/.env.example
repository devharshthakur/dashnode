# Web app configuration (see src/env.ts)
# Copy this file to `apps/web/.env` for local development. Vite loads `.env` in
# every mode and also reads `.env.local`, `.env.[mode]`, and `.env.[mode].local`;
# only `VITE_`-prefixed variables reach the browser. Hosting platforms should
# supply the production values.
#
# The schema in `src/lib/schemas/env.ts` validates every value listed here.

# Base URL of the Express API. The API's CORS_ORIGIN must allow the browser
# origin that calls it, not this value.
VITE_API_URL=http://localhost:8000
