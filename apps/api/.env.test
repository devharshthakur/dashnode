# Environment for the Vitest suite (see src/env.ts). Committed on purpose so
# `pnpm test` works on a fresh clone; every value here is fake.
#
# NODE_ENV is deliberately absent: Vitest sets it to `test`, and src/env.ts
# needs it to choose this file in the first place.

# Keeps pino and pino-pretty out of the test report.
LOG_LEVEL=silent

# Throwaway. Nothing outside a test run signs with it.
JWT_SECRET=test-only-signing-secret-never-used-outside-tests

# MONGO_URI is deliberately absent: the replica-set harness hands its in-memory
# URI to the workers, and a value here would only mask a harness that failed to
# start.
#
# HTTP_BASE_URL is deliberately absent so env.test.ts can prove that no other
# environment leaks in.
