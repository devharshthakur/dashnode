{
  "name": "api",
  "private": true,
  "type": "module",
  "imports": {
    "#services/*": "./src/services/*.ts",
    "#middlewares/*": "./src/middlewares/*.ts",
    "#routes/*": "./src/routes/*.ts",
    "#config/*": "./src/config/*.ts",
    "#env": "./src/env.ts"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongodb",
    "dev": "nodemon",
    "build": "tsdown",
    "start": "node build/index.mjs",
    "preview": "node build/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown --list-different .",
    "check": "prettier --check ."
  },
  "dependencies": {
    "axios": "1.20.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "mongoose": "9.10.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@packages/eslint-config": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.1",
    "eslint": "10.10.0",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.8",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
