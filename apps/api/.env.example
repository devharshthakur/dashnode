# API server configuration (see src/env.ts)
NODE_ENV=development
PORT=3001

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Local MongoDB, started as a single-node replica set (docker compose up -d).
# `directConnection=true` is the safe way to reach a single-node set locally and
# keeps multi-document transactions available (see src/config/db.ts).
MONGO_URI=mongodb://localhost:27017/hashnode?directConnection=true

# Comma-separated list of origins allowed to call the API (see src/config/cors.ts)
CORS_ORIGIN=http://localhost:5173

# Shared outbound HTTP client (see src/lib/http.ts)
HTTP_TIMEOUT_MS=10000
# Optional base URL applied to every request made with the shared client
# HTTP_BASE_URL=https://api.example.com
