# API server configuration (see src/env.ts)
# Copy this file to `apps/api/.env` for local development. The file a run reads
# is chosen by NODE_ENV: `.env.test` for tests, `.env` for development and for a
# local production run. A deployment relies on the hosting platform's injected
# values, which `loadEnvFile` never overwrites.
NODE_ENV=development
PORT=8000

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Local MongoDB, started as a single-node replica set (docker compose up -d).
# The driver discovers the set via its advertised `localhost` member, which keeps
# multi-document transactions available (see src/config/db.ts).
MONGO_URI=mongodb://localhost:27017/hashnode

# Comma-separated list of origins allowed to call the API (see src/config/cors.ts).
# Both local origins are listed because the web app serves the dev server on 5173
# and a production preview on 3000, and it forwards the browser's own origin.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Server-only secret used to sign session JWTs (min 32 chars). Generate one with:
#   openssl rand -base64 32
# Never commit the real value or expose it to the web app.
JWT_SECRET=replace-with-a-random-32-plus-character-secret

# Shared outbound HTTP client (see src/lib/http.ts)
HTTP_TIMEOUT_MS=10000

# Optional base URL applied to every request made with the shared
# HTTP_BASE_URL=https://api.example.com
