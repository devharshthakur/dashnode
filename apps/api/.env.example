# API server configuration (see src/env.ts)
NODE_ENV=development
PORT=3001

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Local MongoDB (docker compose up -d)
MONGO_URI=mongodb://localhost:27017/hashnode

# Shared outbound HTTP client (see src/lib/http.ts)
HTTP_TIMEOUT_MS=10000
# Optional base URL applied to every request made with the shared client
# HTTP_BASE_URL=https://api.example.com
